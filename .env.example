# AWS Credentials & Configuration Template
# Copy this file to .env and fill in your actual AWS access details.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# S3 & CloudFront Frontend Deployment
S3_BUCKET_NAME=newtype-webgame-frontend
CLOUDFRONT_DISTRIBUTION_ID=your_cloudfront_distribution_id

# Backend Serverless Environment Variables
DYNAMODB_TABLE_PREFIX=newtype
